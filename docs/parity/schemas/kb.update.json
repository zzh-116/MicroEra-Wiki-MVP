{
  "id": "kb.update",
  "version": "1",
  "title": "Update a knowledge base",
  "kind": "mutation",
  "risk": "write",
  "inputSchema": {
    "type": "object",
    "properties": {
      "kb_id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "visibility": {
        "type": "string",
        "enum": [
          "public",
          "internal"
        ]
      }
    },
    "required": [
      "kb_id"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "visibility": {
        "type": "string",
        "enum": [
          "public",
          "internal"
        ]
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "slug"
    ]
  }
}