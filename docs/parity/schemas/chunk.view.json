{
  "id": "chunk.view",
  "version": "1",
  "title": "View a document chunk",
  "kind": "query",
  "risk": "read",
  "inputSchema": {
    "type": "object",
    "properties": {
      "doc_id": {
        "type": "integer"
      },
      "chunk_id": {
        "type": "string"
      }
    },
    "required": [
