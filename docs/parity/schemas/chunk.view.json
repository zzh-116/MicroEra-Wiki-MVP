      "chunk_id"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "document_id": {
        "type": "integer"
      },
      "index": {
        "type": "integer"
      },
      "text": {
        "type": "string"
      },
      "strategy": {
        "type": "string"
      },
      "heading": {
        "type": "string"
      },
      "start_char": {
        "type": "integer"
      },
      "end_char": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "document_id",
      "index",
      "text"
    ]
  }
}