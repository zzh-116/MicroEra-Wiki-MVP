{
  "id": "doc.ocr",
  "version": "1",
  "title": "Run OCR over document images",
  "kind": "mutation",
  "risk": "read",
  "inputSchema": {
    "type": "object",
    "properties": {
      "doc_id": {
        "type": "integer"
      }
    },
    "required": [
      "doc_id"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "doc_id": {
        "type": "integer"
      },
      "ocr_status": {
        "type": "string"
      },
      "images": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  }
}