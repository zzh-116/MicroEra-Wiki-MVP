{
  "id": "model.view",
  "version": "1",
  "title": "View a model",
  "kind": "query",
  "risk": "read",
  "inputSchema": {
    "type": "object",
    "properties": {
      "model_id": {
        "type": "integer"
      }
    },
    "required": [
      "model_id"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "kind": {
        "type": "string",
        "enum": [
          "llm",
          "embedding",
          "rerank"
        ]
      },
      "provider": {
        "type": "string"
      },
      "model_name": {
        "type": "string"
      },
      "base_url": {
        "type": "string"
      },
      "config": {
        "type": "object"
      },
      "is_default": {
        "type": "boolean"
      },
      "status": {
        "type": "string"
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "kind",
      "model_name"
    ]
  }
}