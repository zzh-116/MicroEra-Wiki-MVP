{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "backend/config.ts",
    "backend/types.ts",
    "backend/db/schema.ts",
    "backend/db/connection.ts",
    "backend/repositories/file.repository.ts",
    "backend/services/object-storage.service.ts",
    "backend/services/file-migration.service.ts",
    "server/routes/files.ts",
    "scripts/upload-local-file-to-minio.mts",
    "scripts/migrate-files-to-minio.mts",
    "scripts/pdf-storage-dry-run.mts",
    "scripts/audit-entry-files.mts",
    "scripts/analyze-no-entry-files.mts",
    "scripts/test-single-pdf-minio.mts",
    "tests/services/object-storage.test.ts",
    "tests/services/file-migration.test.ts",
    "tests/routes/files.test.ts"
  ]
}
