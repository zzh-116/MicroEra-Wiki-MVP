# Server
PORT=3001
JWT_SECRET=your-random-secret-here

# Ollama (local LLM deployment)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# Milvus Vector DB (optional - falls back to in-memory store)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=wiki_entries
EMBEDDING_DIM=1024

# Vite (frontend dev server)
VITE_API_BASE_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/microera_wiki

# Data directory
DATA_DIR=./backend/data

# Docling CLI (document parser) — optional, overrides PATH discovery so a fresh
# checkout does not depend on any one user's absolute install path.
#   DOCLING_CMD     = explicit path/name to docling.exe (e.g. C:\...\Python312\Scripts\docling.exe)
#   DOCLING_PYTHON  = Python interpreter for the import probe + version check (3.10–3.12)
DOCLING_CMD=
DOCLING_PYTHON=

# MinIO / S3-compatible object storage (optional; Wiki boots without it)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=wiki-docs
MINIO_USE_SSL=false

# DeepSeek API (online LLM for Vercel demo)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Feishu Connector
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_WIKI_SPACE_ID=your-wiki-space-id

# Sandbox Data Platform
SANDBOX_BASE_URL=http://your-sandbox-server:6810
SANDBOX_USERNAME=admin
SANDBOX_PASSWORD=your-sandbox-password

# Sandbox MySQL direct connection (preferred over HTTP API)
# Set SANDBOX_DB_ENABLED=true to use DB mode — eliminates N+1 HTTP requests
SANDBOX_DB_ENABLED=false
SANDBOX_DB_HOST=your-sandbox-db-host
SANDBOX_DB_PORT=3306
SANDBOX_DB_NAME=your-sandbox-db-name
SANDBOX_DB_USER=your-sandbox-db-user
SANDBOX_DB_PASSWORD=

# LLM Provider: ollama or deepseek
LLM_PROVIDER=ollama

# Agent MCP (agent.mcp_test / agent.mcp_call) SSRF allow-list.
# Comma-separated exact endpoints that may be non-public (loopback/private), e.g.
#   MCP_TRUSTED_HOSTS=localhost:8080,127.0.0.1:9001
# Leave empty to default-deny loopback/private/link-local/metadata. Never use a
# wildcard here — there is no "open all localhost" switch.
MCP_TRUSTED_HOSTS=

